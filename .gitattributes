# Left out of `git archive` and of the release zip (.github/workflows/release.yml excludes the same paths: keep the
# two lists equal, because includes/release-hashes.txt must list exactly the PHP files the zip ships). Sites never
# need them, and tests/ holds web-shell fixtures a scanner would have to exempt.
/tests export-ignore
/docs export-ignore
/CONTRIBUTING.md export-ignore
/.github export-ignore
/.gitattributes export-ignore
